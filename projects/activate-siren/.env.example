# Activate Siren notification providers
# Copy these names into Netlify site environment variables.
# Never commit real credential values.

RESEND_API_KEY=
RESEND_FROM_EMAIL=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Activate Siren paid unlock
# Use sandbox until the full checkout flow is verified.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Required unlock price. Example format only: 4.99
SIREN_UNLOCK_PRICE=
SIREN_UNLOCK_CURRENCY=USD

# Creator bypass: set this to the creator's server-issued visitorId.
ACTIVATE_SIREN_CREATOR_VISITOR_ID=
